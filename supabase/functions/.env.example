# Secrets des Edge Functions en local : copier vers supabase/functions/.env (non versionné), puis « supabase start ».
# Par défaut, nyole est simulé par le test d'intégration (apps/mobile/test/integration/mobile_money_test.dart).
# Pour essayer le vrai mode test nyole : NYOLE_API_URL=https://app.nyole.com/api et NYOLE_SECRET_KEY=af_test_sec_…
NYOLE_API_URL=http://host.docker.internal:54390/api
NYOLE_SECRET_KEY=af_test_sec_simulation_locale
# Stripe (cartes) simulé par le test d'intégration (apps/mobile/test/integration/card_payment_test.dart).
# Pour le vrai mode test : STRIPE_API_URL=https://api.stripe.com, STRIPE_SECRET_KEY=sk_test_…,
# STRIPE_WEBHOOK_SECRET=whsec_… (Stripe CLI : stripe listen --forward-to …/functions/v1/payments-webhook-stripe).
STRIPE_API_URL=http://host.docker.internal:54391
STRIPE_SECRET_KEY=sk_test_simulation_locale
STRIPE_WEBHOOK_SECRET=whsec_simulation_locale
# Page affichée après un paiement par carte (fonction payments-return), vue depuis le navigateur du client.
PAYMENT_RETURN_URL=http://127.0.0.1:54321/functions/v1/payments-return
