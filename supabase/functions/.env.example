# Secrets des Edge Functions en local : copier vers supabase/functions/.env (non versionné), puis « supabase start ».
# Par défaut, nyole est simulé par le test d'intégration (apps/mobile/test/integration/mobile_money_test.dart).
# Pour essayer le vrai mode test nyole : NYOLE_API_URL=https://app.nyole.com/api et NYOLE_SECRET_KEY=af_test_sec_…
NYOLE_API_URL=http://host.docker.internal:54390/api
NYOLE_SECRET_KEY=af_test_sec_simulation_locale
